<?xml version="1.0" encoding="utf-8"?>
<!--
    Coomi 设计令牌 · 颜色
    主色 蓝 #2D61C6 + 白，点缀色 橙 #D47458。
    命名规则：coomi_<角色>[_<变体>]，只在浅色主题下使用（onboarding / dashboard）。
    终端本体（Theme.TermuxActivity）仍走原有深色配色，不受影响。
-->
<resources>

    <!-- ============ 品牌蓝 ============ -->
    <color name="coomi_blue">#2D61C6</color>
    <color name="coomi_blue_press">#2551A8</color>
    <color name="coomi_blue_disabled">#A8BEE8</color>
    <!-- 浅蓝底：选中态 chip / 图标底 / 高亮块 -->
    <color name="coomi_blue_soft">#E8EEFB</color>
    <color name="coomi_blue_faint">#F3F6FD</color>
    <color name="coomi_blue_border">#C6D5F2</color>
    <!-- logo 里的四角星色，用于装饰性小元素 -->
    <color name="coomi_star">#92B4EE</color>

    <!-- ============ 点缀橙：需要注意 / 待授权 ============ -->
    <color name="coomi_orange">#D47458</color>
    <color name="coomi_orange_press">#B85F45</color>
    <color name="coomi_orange_soft">#FCEEE9</color>
    <color name="coomi_orange_border">#F0CFC3</color>

    <!-- ============ 中性色 ============ -->
    <color name="coomi_white">#FFFFFF</color>
    <!-- 页面底色（卡片浮在它上面） -->
    <color name="coomi_page">#F4F5F7</color>
    <!-- 卡片内的填充块 / 次级按钮 -->
    <color name="coomi_fill">#F5F6F8</color>
    <color name="coomi_fill_press">#ECEEF1</color>
    <color name="coomi_divider">#EDEFF2</color>
    <color name="coomi_border">#E4E7EC</color>

    <color name="coomi_text">#1B1D21</color>
    <color name="coomi_text_2">#6B7280</color>
    <color name="coomi_text_3">#9CA3AF</color>
