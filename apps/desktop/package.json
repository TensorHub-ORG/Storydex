{
  "name": "storydex-desktop",
  "private": true,
  "version": "2.0.8",
  "description": "Storydex desktop app",
  "scripts": {
    "dev": "npm run dev:tauri",
    "dev:tauri": "npx --no-install tauri dev --config tauri-preview/tauri.conf.json",
    "build:frontend": "npm --prefix ../frontend run build",
    "check:encoding": "node ../../scripts/validate_text_encoding.cjs",
    "check:release": "node scripts/validate-release-config.cjs",
    "check:packaged": "node scripts/validate-tauri-release-assets.cjs",
    "check:rust-candidate": "node scripts/validate-rust-candidate-assets.cjs",
    "check:tauri": "cargo check --manifest-path tauri-preview/Cargo.toml --locked",
    "check:tauri-preview": "npm run check:tauri",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/rust-candidate-assets.test.cjs tests/tauri-candidate-contract.test.cjs tests/tauri-release-contract.test.cjs ../../scripts/tests/generate-release-metadata.test.cjs ../../scripts/tests/rust-backend-interface-inventory.test.cjs",
    "test:smoke": "npm run smoke:tauri",
    "test:e2e": "npm run smoke:tauri",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tauri-preview/scripts/package-preview.ps1",
    "package:win": "npm run build:desktop",
    "build:tauri-preview": "npm run build:desktop",
    "smoke:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File tauri-preview/scripts/smoke-preview.ps1",
    "smoke:tauri-preview": "npm run smoke:tauri",
    "test:smoke:tauri": "npm run smoke:tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
