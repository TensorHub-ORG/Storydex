{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storydex",
  "version": "2.0.9",
  "identifier": "cn.tensorhub.storydex",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-preview.ps1"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../../assets/Storydex_icon/storydex_icon_01.ico"],
    "licenseFile": "../build/installer-license.zh-CN.txt",
    "createUpdaterArtifacts": true,
    "windows": {
      "minimumWebview2Version": "110.0.1587.46",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Storydex"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "__STORYDEX_TAURI_UPDATER_PUBKEY__",
      "endpoints": ["https://updates.septemc.com/storydex/windows/latest.json"]
    }
  }
}
