{
  "schemaVersion": 1,
  "contractId": "agent.chat.stream.v1",
  "scenario": "story-modify-existing-provider-error-before-write-replay",
  "allowMutatingTools": true,
  "request": {
    "prompt": "请重写已存在的章节文件 chapters/fixture-story.md，只调用一次 write_file 完成写入。请求标记 STORYDEX_STORY_MODIFY_PROVIDER_ERROR_PROMPT_7A2D。",
    "activeFile": "chapters/fixture-story.md",
    "reasoningEffort": "low",
    "storyGeneration": {
      "fragmentCount": 1,
      "chapterLengthTier": "short"
    },
    "confirmNoSnapshot": true,
    "permissionMode": "approve_for_me",
    "capabilityMode": "scoped_write",
    "writesAllowed": true,
    "coreWritesAllowed": true,
    "allowedWriteRoots": ["chapters/"]
  },
  "workspace": {
    "initializeGit": true,
    "initializeStorydex": true,
    "stabilizeRuntimeBaseline": true,
    "files": [
      {
        "path": "chapters/fixture-story.md",
        "content": "# Fixture Story\n\nStatus: draft\nMarker: STORYDEX_STORY_MODIFY_PROVIDER_ERROR_BEFORE_B95F\n"
      }
    ]
  },
  "expected": {
    "providerId": "OPENCODE",
    "model": "deepseek-v4-flash",
    "providerMode": "replay",
    "toolSequence": [],
    "providerCompletionCount": 0,
    "replyContains": [],
    "terminalEvent": "AgentError",
    "errorContains": ["expected message marker"],
    "httpStatus": 200,
    "requiredEventSequence": ["AgentStarted", "AgentError"],
    "forbiddenEvents": [
      "ToolStart",
      "ToolDone",
      "TextChunk",
      "StoryProviderAttempt",
      "StoryCommitStarted",
      "StoryCommitFinished",
      "StoryDraftMeasured",
      "StoryGenerationValidation",
      "StoryCallAccounting"
    ]
  }
}
