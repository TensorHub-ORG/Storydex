      {
        "path": "chapters/agent-stream-followup.md",
        "content": "# Agent stream follow-up fixture\n\nSTORYDEX_AGENT_STREAM_FOLLOWUP_FILE_5D77\n"
      }
    ]
  },
  "expected": {
    "providerId": "OPENCODE",
    "model": "deepseek-v4-flash",
