    {
      "action": "resume_followups"
    }
  ],
  "workspace": {
    "initializeGit": true,
    "files": [
      {
        "path": ".storydex/config/project-settings.json",
        "content": "{\n  \"agentCommitPromptEnabled\": false\n}\n"
