    "toolSequence": ["read_file"],
    "replyContains": ["STORYDEX_AGENT_STREAM_FOLLOWUP_FILE_5D77"],
    "terminalEvent": "AgentCompleted",
    "followupPersistence": true,
    "followupEvents": ["FollowupQueued", "ContinuationStarted", "FollowupUpdated"],
