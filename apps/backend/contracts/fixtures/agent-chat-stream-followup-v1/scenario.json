{
  "schemaVersion": 1,
  "contractId": "agent.chat.stream.v1",
  "scenario": "durable-queued-followup-resume",
  "request": {
    "prompt": "This placeholder must be replaced by the durable follow-up payload.",
    "activeFile": "",
    "reasoningEffort": "low",
    "confirmNoSnapshot": true,
    "sourceFollowupMessageId": "followup-contract-1",
    "sourceFollowupExpectedTraceId": "",
