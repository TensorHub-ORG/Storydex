{
  "schemaVersion": 1,
  "contractId": "agent.chat.stream.v1",
  "scenario": "approval-deny-and-duplicate-decision",
  "intentRoutingMode": "direct",
  "allowMutatingTools": true,
  "request": {
    "prompt": "Update the existing repository state by executing exactly one shell command. The command writes approval-deny-output.txt and must ask the user for approval. After denial, finish with AGENT_APPROVAL_DENY_REPLY_7A31. Marker AGENT_APPROVAL_DENY_PROMPT_3C22.",
    "activeFile": "",
    "reasoningEffort": "low",
    "confirmNoSnapshot": true,
    "permissionMode": "ask_approval",
    "capabilityMode": "workspace_write",
    "writesAllowed": true,
    "coreWritesAllowed": true,
    "timeoutMs": 0
  },
  "interaction": {
    "action": "approval",
    "afterEvent": "PermissionRequest",
    "decision": "deny",
    "repeatDecision": 2
  },
  "workspace": {
    "initializeGit": true,
    "initializeStorydex": true,
    "stabilizeRuntimeBaseline": true,
    "files": [
      {
        "path": ".storydex/config/project-settings.json",
        "content": "{\n  \"agentCommitPromptEnabled\": false\n}\n"
      }
    ]
  },
  "expected": {
    "providerId": "OPENCODE",
    "model": "deepseek-v4-flash",
    "providerMode": "replay",
    "toolSequence": ["shell"],
    "toolErrorSequence": ["shell"],
    "replyContains": ["AGENT_APPROVAL_DENY_REPLY_7A31"],
    "terminalEvent": "AgentCompleted",
    "sessionPersistence": true,
    "workspaceEffects": {
      "changedPaths": [],
      "createdPaths": [],
      "modifiedPaths": [],
      "deletedPaths": [],
      "gitPresent": true,
      "gitHeadUnchanged": true,
      "gitStatusBefore": [],
      "gitStatusAfter": [],
      "excludedPrefixes": [".git/", ".storydex/.agent/", ".storydex/.cache/"],
      "files": {
        "approval-deny-output.txt": {
          "exists": false,
          "size": 0,
          "sha256": ""
        }
      }
    },
    "httpStatus": 200
  }
}
